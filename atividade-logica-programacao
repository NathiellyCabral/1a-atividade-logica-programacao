programa {
    // 1ª ATIVIDADE A SER LANÇADA NO GITHUB - 29/10/2026
    // Professor Tarcisio
    
    funcao inicio() {
        inteiro resposta
        resposta = 1
        
        enquanto(resposta == 1){
            // solução do algoritmo aqui
            inteiro x, num
            
            escreva("Digite um Numero: ")
            leia(num)
            
            x = 1
            
            se(num >= 30){
                enquanto(x <= 5){
                    num++
                    se(num % 2 == 0){
                        escreva(num + " ")
                        x++
                    }
                }
            }senao{
                enquanto(x <= 5){
                    num--
                    se(num % 2 == 1){
                        escreva(num + " ")
                        x++
                    }
                }
            }
            
            escreva("\n")
            
            // FINALIZAÇÃO DO ALGORITMO
            escreva("\nDeseja continuar? \n1 - SIM \n2 - NAO\n")
            leia(resposta)
            
            enquanto((resposta != 1) e (resposta != 2)){
                escreva("Erro! Digite 1 - sim / 2 - nao: ")
                leia(resposta)
            }
        }
    }
}